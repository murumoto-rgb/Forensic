# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit credentials.

# Server
PORT=3000
NODE_ENV=development

# Supabase — values come from your project's dashboard:
# Settings → API → Project URL and the publishable + secret keys
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudflare R2 — values come from cloudflare.com → R2:
# - Account ID: shown in the R2 dashboard URL and overview page
# - Access Key ID + Secret Access Key: from a bucket-scoped R2 API
#   token created with "Object Read & Write" permission
# - Bucket name: the bucket you created (e.g. forensic-photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forensic-photos

# CORS — comma-separated list of origins the server accepts.
# In dev: include http://localhost:5173 (Vite default).
# In prod: include the Vercel URL once the web app is deployed.
CORS_ORIGINS=http://localhost:5173

# Anthropic API key for the AI-tagging proxy (`POST /v1/ai/tag-photo`).
# Optional — the server starts cleanly without it; the AI endpoint
# returns 503 "AI tagging not configured" until set. Issue a key at
# console.anthropic.com → API Keys, then paste here (or set on Render's
# Environment tab in production).
ANTHROPIC_API_KEY=
