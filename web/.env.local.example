# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# All values are exposed to the browser (Vite prefixes any VITE_* var
# into the client bundle). Use ONLY the publishable Supabase key here,
# never the secret key.

# Supabase
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Forensic server (your Fastify API)
# Local dev: http://localhost:3000
# Production: https://<your-render-url>
VITE_API_URL=http://localhost:3000

# Sentry browser error reporting (Build #5.57.1). Optional. Set on
# Vercel → Project → Environment Variables for production.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog product analytics (Build #5.57.1). Optional. Grab the key
# at posthog.com → Project Settings → Project API Key.
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when blank.
VITE_POSTHOG_HOST=
