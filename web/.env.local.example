# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
# All values are exposed to the browser (Vite prefixes any VITE_* var
# into the client bundle). Use ONLY the publishable Supabase key here,
# never the secret key.

# Supabase
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Forensic server (your Fastify API)
# Local dev: http://localhost:3000
# Production: https://<your-render-url>
VITE_API_URL=http://localhost:3000
